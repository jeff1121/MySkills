# FinMind MCP Server 環境變數範例
# 複製此檔為 .env 並填入你的設定

# FinMind API Token（必填）
# 到 https://finmindtrade.com/ 註冊並登入取得
FINMIND_TOKEN=your_token_here

# API 基礎網址（通常不需要更改）
# FINMIND_API_BASE_URL=https://api.finmindtrade.com/api/v4

# MCP Server 連接埠（預設 8080）
# MCP_SERVER_PORT=8080

# 日誌等級（DEBUG / INFO / WARNING / ERROR）
# LOG_LEVEL=INFO
